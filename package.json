{
  "name": "ofca",
  "version": "0.0.0",
  "private": true,
  "description": "Ordered flow with callback-first concurrent arrival",
  "type": "module",
  "keywords": [
    "ofca",
    "ordered",
    "concurrency",
    "async-iterator",
    "backpressure",
    "compose",
    "stream"
  ],
  "license": "MIT",
  "author": "Scramjet <opensource@scramjet.org>",
  "repository": {
    "type": "git",
    "url": "git://github.com/scramjetorg/ofca.git"
  },
  "homepage": "https://github.com/scramjetorg/ofca#readme",
  "bugs": {
    "url": "https://github.com/scramjetorg/ofca/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','.build'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build:ts": "tsc --project tsconfig.json",
    "build:pkg": "node scripts/build-package.js",
    "build": "npm run clean && npm run build:ts && npm run build:pkg",
    "typecheck": "npm run build && tsc --noEmit --project tsconfig.test.json",
    "check": "biome check .",
    "test": "npm run build && node --test test/*.test.js",
    "test:bun": "npm run build && bun test test/*.test.js",
    "coverage": "npm run build && c8 --reporter=text --reporter=lcov --reports-dir=coverage --include=\"dist/**/*.js\" node --test test/*.test.js",
    "verify": "npm run build && node scripts/verify-package.js && npm pack --dry-run ./dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "c8": "^12.0.0",
    "typescript": "^5.9.3"
  }
}
